{
  "name": "yonlink-crm",
  "version": "0.1.0",
  "private": true,
  "description": "永联CRM / Yonlink-CRM — 最小化 MVP",
  "type": "module",
  "scripts": {
    "db:start": "node scripts/db.mjs start",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:pages": "BUILD_TARGET=pages next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:seed-demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/linux-arm64@18.6.0-beta.19": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
