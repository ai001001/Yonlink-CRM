# 永联CRM 环境变量示例（复制为 .env，并替换为真实值；.env 不得提交）
# Yonlink-CRM env example (copy to .env with real values; never commit .env)
# 本地开发可直接运行 `npm run db:start` 自动生成 .env / `npm run db:start` generates .env for local dev
YONLINK_DATA_DIR=/home/ai/yonlink-data/mvp
PG_PORT=54330
PG_USER=yonlink
PG_PASSWORD=change-me
DATABASE_URL=postgresql://yonlink:change-me@127.0.0.1:54330/yonlink_mvp_dev
TEST_DATABASE_URL=postgresql://yonlink:change-me@127.0.0.1:54330/yonlink_mvp_test

# 初始管理员（npm run db:seed）/ initial admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# 允许跨域访问 API 的前端来源（逗号分隔）/ frontend origins allowed to call the API
CORS_ORIGINS=https://ai001001.github.io

# 前端：后端地址（空=同源）；静态预览标记 / frontend: backend URL (empty = same origin); static preview flag
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_STATIC_PREVIEW=0
