// 永联CRM MVP 数据模型 / Yonlink-CRM MVP data model
// 约定 / Conventions:
//  - 所有业务表带 organization_id，由服务端会话决定 / every business table carries organization_id set by the server session
//  - UUID 主键、timestamptz(UTC)、金额 Decimal(18,2) / UUID PKs, UTC timestamptz, Decimal(18,2) money

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String                  @id @default(uuid()) @db.Uuid
  name             String                  @db.VarChar(200)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  users            User[]
  accounts         Account[]
  contacts         Contact[]
  leads            Lead[]
  deals            Deal[]
  activities       Activity[]
  auditLogs        AuditLog[]
  notes            Note[]
  products         Product[]
  dealItems        DealLineItem[]
  quotes           Quote[]
  quoteItems       QuoteLineItem[]
  tags             Tag[]
  leadTags         LeadTag[]
  accountTags      AccountTag[]
  dealTags         DealTag[]
  recycleBin       RecycleBinItem[]
  savedViews       SavedView[]
  viewDefaults     UserViewDefault[]
  dashboardLayouts UserDashboardLayout[]
  tickets          Ticket[]
  ticketCounters   TicketCounter[]
  ticketComments   TicketComment[]
  ticketSla        TicketSlaPolicy?
  kbArticles       KbArticle[]
  ticketArticles   TicketArticle[]
  vendors          Vendor[]
  purchaseOrders   PurchaseOrder[]
  purchaseLines    PurchaseOrderLineItem[]
  documentCounters DocumentCounter[]
  priceBooks       PriceBook[]
  priceBookEntries PriceBookEntry[]
  priceBookTiers   PriceBookTier[]
  webForms         WebForm[]
  scoringRules     ScoringRule[]
  scoringSettings  ScoringSettings[]
  attachments      Attachment[]
  salesTargets     SalesTarget[]
  notifications    Notification[]
  salesOrders      SalesOrder[]
  salesOrderItems  SalesOrderLineItem[]
  invoices         Invoice[]
  invoiceItems     InvoiceLineItem[]
  invoicePayments  InvoicePayment[]
  exchangeRates    ExchangeRate[]
  campaigns        Campaign[]
  dealContactRoles DealContactRole[]
  dealCompetitors  DealCompetitor[]
  assignmentRules  AssignmentRule[]
  assignmentUsers  AssignmentRuleUser[]
  dealStageHistory DealStageHistory[]
  workflowRules    WorkflowRule[]
  quoteApprovals   QuoteApproval[]
  approvalSettings QuoteApprovalSettings?
  stockMovements   StockMovement[]

  @@map("organizations")
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  email              String                  @db.VarChar(254)
  name               String                  @db.VarChar(100)
  passwordHash       String                  @map("password_hash")
  notifications      Notification[]          @relation("NotificationRecipient")
  notificationsSent  Notification[]          @relation("NotificationActor")
  createdOrders      SalesOrder[]            @relation("OrderCreator")
  createdInvoices    Invoice[]               @relation("InvoiceCreator")
  recordedPayments   InvoicePayment[]        @relation("PaymentRecorder")
  ratesCreated       ExchangeRate[]          @relation("RateCreator")
  ownedCampaigns     Campaign[]              @relation("CampaignOwner")
  /// 角色（服务端每个请求从数据库读取）/ role (read from the DB on every request)
  role               UserRole                @default(SALES)
  isActive           Boolean                 @default(true) @map("is_active")
  /// 演示账号：仅在 DEMO_LOGIN_ENABLED=1 时可免密一键登录 / demo account: password-less login only when DEMO_LOGIN_ENABLED=1
  isDemo             Boolean                 @default(false) @map("is_demo")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions           Session[]
  ownedLeads         Lead[]                  @relation("LeadOwner")
  ownedAccounts      Account[]               @relation("AccountOwner")
  ownedDeals         Deal[]                  @relation("DealOwner")
  ownedActivities    Activity[]              @relation("ActivityOwner")
  auditLogs          AuditLog[]              @relation("AuditActor")
  notes              Note[]                  @relation("NoteAuthor")
  createdQuotes      Quote[]                 @relation("QuoteCreator")
  deletedItems       RecycleBinItem[]        @relation("RecycleDeleter")
  savedViews         SavedView[]
  viewDefaults       UserViewDefault[]
  dashboardLayout    UserDashboardLayout?
  tickets            Ticket[]                @relation("TicketOwner")
  slaEscalations     TicketSlaPolicy[]       @relation("SlaEscalateTo")
  kbArticles         KbArticle[]             @relation("KbArticleAuthor")
  ticketArticleLinks TicketArticle[]         @relation("TicketArticleLinker")
  purchaseOrders     PurchaseOrder[]         @relation("PurchaseOrderCreator")
  webFormsOwned      WebForm[]               @relation("WebFormOwner")
  webFormsCreated    WebForm[]               @relation("WebFormCreator")
  ticketComments     TicketComment[]         @relation("TicketCommentAuthor")
  uploads            Attachment[]            @relation("AttachmentUploader")
  salesTargets       SalesTarget[]           @relation("TargetOwner")
  targetsUpdated     SalesTarget[]           @relation("TargetUpdater")
  assignmentRules    AssignmentRuleUser[]
  dealStageChanges   DealStageHistory[]      @relation("StageChanger")
  workflowRules      WorkflowRule[]          @relation("WorkflowCreator")
  quoteApprovals     QuoteApproval[]         @relation("ApprovalActor")
  approvalSettings   QuoteApprovalSettings[] @relation("ApprovalSettingsUpdater")
  stockMovements     StockMovement[]         @relation("StockActor")

  // 支持 (organization_id, id) 复合外键，防止跨组织引用负责人
  // composite key so owner FKs cannot point at another organization's user
  @@unique([organizationId, id])
  @@unique([email])
  @@map("users")
}

/// 系统角色 / System roles
enum UserRole {
  ADMIN
  MANAGER
  SALES
  READONLY

  @@map("user_role")
}

/// 服务端会话：只保存令牌的 SHA-256 哈希 / server session: only the SHA-256 hash of the token is stored
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED

  @@map("lead_status")
}

model Lead {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  ownerId            String?        @map("owner_id") @db.Uuid
  /// 来源市场活动 / source campaign
  campaignId         String?        @map("campaign_id") @db.Uuid
  name               String         @db.VarChar(100)
  company            String?        @db.VarChar(200)
  title              String?        @db.VarChar(100)
  phone              String?        @db.VarChar(50)
  mobile             String?        @db.VarChar(50)
  email              String?        @db.VarChar(254)
  source             String?        @db.VarChar(50)
  status             LeadStatus     @default(NEW)
  description        String?        @db.Text
  notifications      Notification[]
  // 线索转化结果（只由服务端转化流程写入）/ conversion result (written only by the server-side conversion)
  // 关联记录删除时置空；同组织约束由数据库触发器保证 / set null on delete; same-org enforced by a DB trigger
  convertedAccountId String?        @map("converted_account_id") @db.Uuid
  convertedContactId String?        @map("converted_contact_id") @db.Uuid
  convertedDealId    String?        @map("converted_deal_id") @db.Uuid
  convertedAt        DateTime?      @map("converted_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?          @relation("LeadOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  convertedAccount   Account?       @relation("LeadConvertedAccount", fields: [convertedAccountId], references: [id], onDelete: SetNull)
  convertedContact   Contact?       @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedDeal      Deal?          @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities         Activity[]
  notes              Note[]
  tags               LeadTag[]
  attachments        Attachment[]

  // 来源市场活动；有关联记录的活动不能删除 / source campaign; campaigns with linked records cannot be deleted
  campaign Campaign? @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  /// 线索评分（由数据库触发器按评分规则计算，客户端不能写入）/ lead score (computed by a database trigger from the scoring rules; never written by clients)
  score Int @default(0)

  /// 来源网页表单（只由公开提交写入；表单删除时置空）/ source web form (written by public submissions only; cleared when the form is deleted)
  webFormId String?  @map("web_form_id") @db.Uuid
  webForm   WebForm? @relation(fields: [webFormId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, campaignId])
  @@index([webFormId])
  @@index([organizationId, score(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([convertedAccountId])
  @@index([convertedContactId])
  @@index([convertedDealId])
  @@map("leads")
}

model Account {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  name           String         @db.VarChar(200)
  industry       String?        @db.VarChar(50)
  phone          String?        @db.VarChar(50)
  website        String?        @db.VarChar(254)
  address        String?        @db.VarChar(500)
  description    String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("AccountOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  notes          Note[]
  convertedLeads Lead[]         @relation("LeadConvertedAccount")
  tags           AccountTag[]
  attachments    Attachment[]
  notifications  Notification[]

  tickets Ticket[]

  /// 客户评分（由数据库触发器按评分规则计算）/ account score (computed by a database trigger from the scoring rules)
  score Int @default(0)

  /// 默认价格表（只能由 product.manage 在价格表中指定）/ default price book (assigned from the price book by product.manage)
  priceBookId String?    @map("price_book_id") @db.Uuid
  priceBook   PriceBook? @relation(fields: [organizationId, priceBookId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, priceBookId])
  @@index([organizationId, score(sort: Desc)])
  @@map("accounts")
}

model Contact {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  accountId      String            @map("account_id") @db.Uuid
  name           String            @db.VarChar(100)
  title          String?           @db.VarChar(100)
  phone          String?           @db.VarChar(50)
  email          String?           @db.VarChar(254)
  isPrimary      Boolean           @default(false) @map("is_primary")
  /// 联系人评分（由数据库触发器按评分规则计算）/ contact score (computed by a database trigger from the scoring rules)
  score          Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 删除客户时级联删除其联系人 / contacts are deleted with their account
  account        Account           @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  convertedLeads Lead[]            @relation("LeadConvertedContact")
  dealRoles      DealContactRole[]
  tickets        Ticket[]

  @@unique([organizationId, id])
  @@index([organizationId, accountId])
  @@index([organizationId, score(sort: Desc)])
  @@map("contacts")
}

enum DealStage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST

  @@map("deal_stage")
}

model Deal {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  ownerId           String?            @map("owner_id") @db.Uuid
  /// 来源市场活动 / source campaign
  campaignId        String?            @map("campaign_id") @db.Uuid
  accountId         String             @map("account_id") @db.Uuid
  name              String             @db.VarChar(200)
  amount            Decimal            @default(0) @db.Decimal(18, 2)
  currency          String             @default("CNY") @db.Char(3)
  stage             DealStage          @default(QUALIFICATION)
  expectedCloseDate DateTime?          @map("expected_close_date") @db.Date
  description       String?            @db.Text
  /// 商机评分（由数据库触发器按评分规则计算）/ deal score (computed by a database trigger from the scoring rules)
  score             Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?              @relation("DealOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  notifications     Notification[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  // 有商机的客户不能删除 / accounts with deals cannot be deleted
  account           Account            @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  activities        Activity[]
  notes             Note[]
  lineItems         DealLineItem[]
  quotes            Quote[]
  convertedLeads    Lead[]             @relation("LeadConvertedDeal")
  tags              DealTag[]
  attachments       Attachment[]
  contactRoles      DealContactRole[]
  competitors       DealCompetitor[]
  stageHistory      DealStageHistory[]

  // 来源市场活动；有关联记录的活动不能删除 / source campaign; campaigns with linked records cannot be deleted
  campaign Campaign? @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, campaignId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, accountId])
  @@index([organizationId, stage])
  @@index([organizationId, score(sort: Desc)])
  @@map("deals")
}

enum ActivityType {
  CALL
  MEETING
  VISIT
  TASK

  @@map("activity_type")
}

model Activity {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  type           ActivityType
  subject        String         @db.VarChar(200)
  content        String?        @db.Text
  dueAt          DateTime?      @map("due_at") @db.Timestamptz(6)
  completed      Boolean        @default(false)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  accountId      String?        @map("account_id") @db.Uuid
  leadId         String?        @map("lead_id") @db.Uuid
  dealId         String?        @map("deal_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("ActivityOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  notifications  Notification[]
  // 关联记录删除时跟进记录一并删除 / activities are removed with the related record
  account        Account?       @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  lead           Lead?          @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, completed, dueAt])
  @@index([organizationId, accountId])
  @@index([organizationId, leadId])
  @@index([organizationId, dealId])
  @@map("activities")
}

/// 审计日志（只能追加：数据库触发器禁止 UPDATE/DELETE；内容已脱敏）
/// Audit log (append-only: a DB trigger forbids UPDATE/DELETE; contents are redacted)
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// 操作人；登录失败等场景为被尝试的账号 / actor; for failed logins the targeted account
  actorId        String?      @map("actor_id") @db.Uuid
  /// 例如 lead.create / auth.login_failed / e.g. lead.create, auth.login_failed
  action         String       @db.VarChar(50)
  entityType     String       @map("entity_type") @db.VarChar(30)
  /// 被操作记录 ID（不设外键，记录删除后日志仍保留）/ target id (no FK so logs outlive the record)
  entityId       String?      @map("entity_id") @db.Uuid
  /// 脱敏后的变更内容 / redacted change set
  changes        Json?        @db.JsonB
  ip             String?      @db.VarChar(64)
  userAgent      String?      @map("user_agent") @db.VarChar(300)
  /// 使用 clock_timestamp()：同一事务内多条记录也能按真实写入顺序排序
  /// clock_timestamp() keeps entries written in one transaction in real order
  createdAt      DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// 备注：只属于一条线索、客户或商机（CHECK 保证恰好一个）；随所属记录级联删除。
/// Note attached to exactly one lead, account or deal (enforced by CHECK); deleted with its record.
model Note {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  content        String       @db.Text
  /// 内容最后一次被修改的时间（未修改为空）/ when the content was last changed (null if never)
  editedAt       DateTime?    @map("edited_at") @db.Timestamptz(6)
  leadId         String?      @map("lead_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User         @relation("NoteAuthor", fields: [organizationId, authorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lead           Lead?        @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  account        Account?     @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt(sort: Desc)])
  @@index([organizationId, accountId, createdAt(sort: Desc)])
  @@index([organizationId, dealId, createdAt(sort: Desc)])
  @@map("notes")
}

/// 产品目录（组织内 SKU 唯一；被商机使用的产品不能删除，只能停用）
/// Product catalog (SKU unique per organization; products in use cannot be deleted, only deactivated)
model Product {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  sku              String           @db.VarChar(50)
  name             String           @db.VarChar(200)
  category         String?          @db.VarChar(50)
  unit             String           @default("件") @db.VarChar(20)
  unitPrice        Decimal          @default(0) @map("unit_price") @db.Decimal(18, 2)
  currency         String           @default("CNY") @db.Char(3)
  description      String?          @db.Text
  isActive         Boolean          @default(true) @map("is_active")
  /// 库存数量（只由库存流水触发器维护）/ quantity in stock (maintained only by the stock-movement trigger)
  stockQuantity    Decimal          @default(0) @map("stock_quantity") @db.Decimal(18, 2)
  /// 再订货水平：库存不高于此值视为低库存；为空表示不提醒 / reorder level: at or below is low stock; null = no alert
  reorderLevel     Decimal?         @map("reorder_level") @db.Decimal(18, 2)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems        DealLineItem[]
  priceBookEntries PriceBookEntry[]
  stockMovements   StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@map("products")
}

/// 商机产品明细（保存下单时的产品名称与 SKU；小计由服务端按十进制精确计算）
/// Deal line item (keeps the product name and SKU at the time; totals computed server-side in decimal)
model DealLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  dealId          String       @map("deal_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  productName     String       @map("product_name") @db.VarChar(200)
  productSku      String       @map("product_sku") @db.VarChar(50)
  quantity        Decimal      @db.Decimal(18, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal      @map("line_total") @db.Decimal(18, 2)
  /// 价格来源价格表名称（快照；手工定价时为空）/ source price book name (snapshot; null for manual prices)
  priceBookName   String?      @map("price_book_name") @db.VarChar(200)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal            Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  product         Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, createdAt])
  @@index([organizationId, productId])
  @@map("deal_line_items")
}

/// 报价单状态 / Quote status
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@map("quote_status")
}

/// 报价单（由商机生成，明细为生成时的快照；草稿可修改，发送后内容冻结）
/// Quote generated from a deal; line items are a snapshot; drafts are editable, content is frozen once sent
model Quote {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  dealId          String          @map("deal_id") @db.Uuid
  salesOrders     SalesOrder[]
  /// 组织内唯一的报价单号，如 QT-2026-0001 / per-organization unique number
  quoteNumber     String          @map("quote_number") @db.VarChar(30)
  subject         String          @db.VarChar(200)
  status          QuoteStatus     @default(DRAFT)
  currency        String          @db.Char(3)
  validUntil      DateTime?       @map("valid_until") @db.Date
  taxPercent      Decimal         @default(0) @map("tax_percent") @db.Decimal(5, 2)
  subtotal        Decimal         @db.Decimal(18, 2)
  taxAmount       Decimal         @map("tax_amount") @db.Decimal(18, 2)
  total           Decimal         @db.Decimal(18, 2)
  terms           String?         @db.Text
  notes           String?         @db.Text
  createdById     String?         @map("created_by_id") @db.Uuid
  sentAt          DateTime?       @map("sent_at") @db.Timestamptz(6)
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal            Deal            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  createdBy       User?           @relation("QuoteCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines           QuoteLineItem[]
  /// 审批状态（未提交为空；修改草稿后清空，需重新审批）/ approval status (null when not submitted; cleared when the draft changes)
  approvalStatus  ApprovalStatus? @map("approval_status")
  /// 提交审批时命中的原因 / reasons that required approval at submission
  approvalReasons Json?           @map("approval_reasons")
  approvals       QuoteApproval[]

  @@unique([organizationId, id])
  @@unique([organizationId, quoteNumber])
  @@index([organizationId, dealId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("quotes")
}

/// 报价单明细（纯快照，不引用产品，产品后续变化或删除不影响已出具的报价单）
/// Quote line item: a pure snapshot without a product reference
model QuoteLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  quoteId         String       @map("quote_id") @db.Uuid
  position        Int
  productSku      String       @map("product_sku") @db.VarChar(50)
  productName     String       @map("product_name") @db.VarChar(200)
  unit            String       @db.VarChar(20)
  quantity        Decimal      @db.Decimal(18, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal      @map("line_total") @db.Decimal(18, 2)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote           Quote        @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, quoteId, position])
  @@map("quote_line_items")
}

/// 标签（组织内名称唯一，不区分大小写：name_key = 小写去空格的名称）
/// Tag; names are unique per organization case-insensitively via name_key (lower-cased, trimmed)
model Tag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(30)
  nameKey        String       @map("name_key") @db.VarChar(30)
  color          String       @default("blue") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          LeadTag[]
  accounts       AccountTag[]
  deals          DealTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@map("tags")
}

/// 线索标签 / Lead tag assignment
model LeadTag {
  organizationId String       @map("organization_id") @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([organizationId, tagId])
  @@map("lead_tags")
}

/// 客户标签 / Account tag assignment
model AccountTag {
  organizationId String       @map("organization_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([accountId, tagId])
  @@index([organizationId, tagId])
  @@map("account_tags")
}

/// 商机标签 / Deal tag assignment
model DealTag {
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@index([organizationId, tagId])
  @@map("deal_tags")
}

/// 回收站对象类型 / Recycle-bin entity type
enum RecycleEntity {
  lead
  account
  deal

  @@map("recycle_entity")
}

/// 回收站条目：删除时保存记录及随之删除的附属数据快照（payload），原记录已真正删除；30 天内可恢复。
/// reserved_numbers 记录快照中报价单的编号，避免被新报价单复用而导致恢复冲突。
/// Recycle-bin entry: a snapshot of the record and the data deleted with it (the rows themselves are gone);
/// restorable for 30 days. reserved_numbers keeps the snapshot's quote numbers from being reused.
model RecycleBinItem {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  entityType      RecycleEntity @map("entity_type")
  entityId        String        @map("entity_id") @db.Uuid
  displayName     String        @map("display_name") @db.VarChar(200)
  /// 附属数据数量摘要 / counts of the related data
  summary         Json
  payload         Json
  reservedNumbers String[]      @default([]) @map("reserved_numbers")
  deletedById     String?       @map("deleted_by_id") @db.Uuid
  deletedAt       DateTime      @default(now()) @map("deleted_at") @db.Timestamptz(6)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedBy       User?         @relation("RecycleDeleter", fields: [organizationId, deletedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, deletedAt(sort: Desc)])
  @@index([organizationId, expiresAt])
  @@map("recycle_bin_items")
}

/// 视图所属列表 / list a saved view belongs to
enum ViewEntity {
  leads
  accounts
  deals
  activities

  @@map("view_entity")
}

/// 保存的视图：列表筛选条件（服务端按列表白名单校验）；私有或共享给全组织。
/// 视图只保存筛选条件，数据仍按查看者的权限过滤，共享视图不会扩大可见范围。
/// Saved view: list filters (validated against a per-list whitelist), private or shared with the organization;
/// records are still filtered by the viewer's permissions, so sharing never widens visibility.
model SavedView {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  ownerId        String            @map("owner_id") @db.Uuid
  entity         ViewEntity
  name           String            @db.VarChar(50)
  filters        Json
  shared         Boolean           @default(false)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User              @relation(fields: [organizationId, ownerId], references: [organizationId, id], onDelete: Cascade)
  defaults       UserViewDefault[]

  @@unique([organizationId, id])
  @@unique([organizationId, ownerId, entity, name])
  @@index([organizationId, entity, shared])
  @@map("saved_views")
}

/// 用户在某个列表的默认视图 / a user's default view for a list
model UserViewDefault {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  entity         ViewEntity
  viewId         String       @map("view_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  view           SavedView    @relation(fields: [organizationId, viewId], references: [organizationId, id], onDelete: Cascade)

  @@id([userId, entity])
  @@index([organizationId, viewId])
  @@map("user_view_defaults")
}

/// 附件元数据；文件内容存放在附件目录 <组织 ID>/<附件 ID>（不使用原文件名，避免路径注入）。
/// 恰好属于一条线索、客户或商机；随所属记录删除（进入回收站快照，彻底删除时才删除文件）。
/// Attachment metadata; content lives at <organization id>/<attachment id> in the attachment directory (never the
/// original name). Belongs to exactly one lead, account or deal; removed with it (kept in the recycle-bin snapshot,
/// the file is deleted only on purge).
model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  leadId         String?      @map("lead_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  fileName       String       @map("file_name") @db.VarChar(200)
  contentType    String       @map("content_type") @db.VarChar(100)
  size           Int
  sha256         String       @db.Char(64)
  uploadedById   String       @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("AttachmentUploader", fields: [organizationId, uploadedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lead           Lead?        @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  account        Account?     @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, dealId, createdAt])
  @@map("attachments")
}

/// 销售目标：负责人 × 月份 × 币种的目标金额（月份为该月 1 日）。
/// Sales target: amount per owner, month (first day of the month) and currency.
model SalesTarget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  month          DateTime     @db.Date
  currency       String       @db.Char(3)
  amount         Decimal      @db.Decimal(18, 2)
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("TargetOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  updatedBy      User?        @relation("TargetUpdater", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, userId, month, currency])
  @@index([organizationId, month])
  @@map("sales_targets")
}

/// 通知类型 / notification type
enum NotificationType {
  /// 记录被分配给我 / a record was assigned to me
  ASSIGNED
  /// 我的跟进即将到期 / my activity is coming due
  ACTIVITY_DUE
  /// 我负责的工单有新评论 / a ticket I own got a comment
  TICKET_COMMENT
  /// 工单超过处理期限已升级 / a ticket passed its due time and was escalated
  TICKET_ESCALATED
  /// 网页表单生成了分配给我的线索 / a web form created a lead assigned to me
  WEB_FORM_LEAD
  /// 工作流规则发出的提醒 / a reminder sent by a workflow rule
  WORKFLOW
  /// 有报价单等我审批 / a quote awaits my approval
  APPROVAL_REQUEST
  /// 我提交的报价单已审批 / my quote submission was decided
  APPROVAL_DECIDED

  @@map("notification_type")
}

/// 站内通知：只属于接收人本人；恰好关联一条线索、客户、商机或跟进，随所属记录删除。
/// title 为生成时的记录名称快照；dedup_key 防止同一提醒重复生成（同一接收人内唯一）。
/// In-app notification owned by its recipient; linked to exactly one lead, account, deal or activity and removed
/// with it. title snapshots the record name; dedup_key keeps a reminder from being generated twice per recipient.
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  actorId        String?          @map("actor_id") @db.Uuid
  leadId         String?          @map("lead_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  dealId         String?          @map("deal_id") @db.Uuid
  activityId     String?          @map("activity_id") @db.Uuid
  ticketId       String?          @map("ticket_id") @db.Uuid
  title          String           @db.VarChar(200)
  dueAt          DateTime?        @map("due_at") @db.Timestamptz(6)
  dedupKey       String?          @map("dedup_key") @db.VarChar(100)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation("NotificationRecipient", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lead           Lead?            @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  account        Account?         @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  activity       Activity?        @relation(fields: [organizationId, activityId], references: [organizationId, id], onDelete: Cascade)
  ticket         Ticket?          @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([organizationId, activityId])
  @@index([organizationId, leadId])
  @@index([organizationId, accountId])
  @@index([organizationId, dealId])
  @@map("notifications")
}

/// 销售订单状态 / sales order status
enum SalesOrderStatus {
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("sales_order_status")
}

/// 销售订单：由已接受的报价单生成，明细与金额为报价单的快照，生成后不再变化；订单不能删除，只能取消。
/// 同一报价单同时只能有一张未取消的订单（部分唯一索引）。
/// Sales order generated from an accepted quote; lines and amounts snapshot the quote and never change; orders are
/// cancelled rather than deleted. One non-cancelled order per quote (partial unique index).
model SalesOrder {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  quoteId          String               @map("quote_id") @db.Uuid
  dealId           String               @map("deal_id") @db.Uuid
  invoices         Invoice[]
  /// 组织内唯一的订单号，如 SO-2026-0001 / per-organization unique number
  orderNumber      String               @map("order_number") @db.VarChar(30)
  subject          String               @db.VarChar(200)
  status           SalesOrderStatus     @default(CONFIRMED)
  currency         String               @db.Char(3)
  taxPercent       Decimal              @map("tax_percent") @db.Decimal(5, 2)
  subtotal         Decimal              @db.Decimal(18, 2)
  taxAmount        Decimal              @map("tax_amount") @db.Decimal(18, 2)
  total            Decimal              @db.Decimal(18, 2)
  expectedDelivery DateTime?            @map("expected_delivery") @db.Date
  shippingAddress  String?              @map("shipping_address") @db.VarChar(500)
  notes            String?              @db.Text
  cancelReason     String?              @map("cancel_reason") @db.VarChar(500)
  createdById      String?              @map("created_by_id") @db.Uuid
  shippedAt        DateTime?            @map("shipped_at") @db.Timestamptz(6)
  deliveredAt      DateTime?            @map("delivered_at") @db.Timestamptz(6)
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 有订单的报价单、商机不能删除 / quotes and deals with orders cannot be deleted
  quote            Quote                @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  deal             Deal                 @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  createdBy        User?                @relation("OrderCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines            SalesOrderLineItem[]
  purchaseOrders   PurchaseOrder[]

  stockMovements StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, dealId])
  @@index([organizationId, quoteId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("sales_orders")
}

/// 销售订单明细（报价单明细的快照）/ Sales order line item (snapshot of the quote line)
model SalesOrderLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  salesOrderId    String       @map("sales_order_id") @db.Uuid
  position        Int
  productSku      String       @map("product_sku") @db.VarChar(50)
  productName     String       @map("product_name") @db.VarChar(200)
  unit            String       @db.VarChar(20)
  quantity        Decimal      @db.Decimal(18, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal      @map("line_total") @db.Decimal(18, 2)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder   @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Cascade)

  @@unique([salesOrderId, position])
  @@index([organizationId, salesOrderId])
  @@map("sales_order_line_items")
}

/// 发票状态（逾期由到期日推算，不单独存储）/ invoice status (overdue is derived from the due date)
enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID

  @@map("invoice_status")
}

/// 收款方式 / payment method
enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  OTHER

  @@map("payment_method")
}

/// 发票：由销售订单生成，明细与金额为订单的快照；已收金额由收款记录汇总，状态随之变化；没有收款时可作废。
/// 同一订单只能有一张未作废的发票（部分唯一索引）；发票不能删除。
/// Invoice generated from a sales order with a snapshot of its lines and amounts; paid amount is the sum of
/// payments and drives the status; void only without payments. One non-void invoice per order (partial unique
/// index); invoices are never deleted.
model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  salesOrderId   String            @map("sales_order_id") @db.Uuid
  dealId         String            @map("deal_id") @db.Uuid
  /// 组织内唯一的发票号，如 INV-2026-0001 / per-organization unique number
  invoiceNumber  String            @map("invoice_number") @db.VarChar(30)
  subject        String            @db.VarChar(200)
  status         InvoiceStatus     @default(UNPAID)
  currency       String            @db.Char(3)
  taxPercent     Decimal           @map("tax_percent") @db.Decimal(5, 2)
  subtotal       Decimal           @db.Decimal(18, 2)
  taxAmount      Decimal           @map("tax_amount") @db.Decimal(18, 2)
  total          Decimal           @db.Decimal(18, 2)
  paidAmount     Decimal           @default(0) @map("paid_amount") @db.Decimal(18, 2)
  /// 开票日汇率快照：1 单位发票币种 = 多少本币；无可用汇率时为空 / rate snapshot on the invoice date (base units per 1 unit); null without a rate
  exchangeRate   Decimal?          @map("exchange_rate") @db.Decimal(18, 8)
  /// 折合本币的发票金额（快照）/ invoice total in the base currency (snapshot)
  baseTotal      Decimal?          @map("base_total") @db.Decimal(18, 2)
  invoiceDate    DateTime          @map("invoice_date") @db.Date
  dueDate        DateTime          @map("due_date") @db.Date
  billingAddress String?           @map("billing_address") @db.VarChar(500)
  notes          String?           @db.Text
  voidReason     String?           @map("void_reason") @db.VarChar(500)
  createdById    String?           @map("created_by_id") @db.Uuid
  paidAt         DateTime?         @map("paid_at") @db.Timestamptz(6)
  voidedAt       DateTime?         @map("voided_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 有发票的订单、商机不能删除 / orders and deals with invoices cannot be deleted
  salesOrder     SalesOrder        @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: Restrict)
  deal           Deal              @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Restrict)
  createdBy      User?             @relation("InvoiceCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines          InvoiceLineItem[]
  payments       InvoicePayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, dealId])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, dueDate])
  @@map("invoices")
}

/// 发票明细（订单明细的快照）/ Invoice line item (snapshot of the order line)
model InvoiceLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  invoiceId       String       @map("invoice_id") @db.Uuid
  position        Int
  productSku      String       @map("product_sku") @db.VarChar(50)
  productName     String       @map("product_name") @db.VarChar(200)
  unit            String       @db.VarChar(20)
  quantity        Decimal      @db.Decimal(18, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal      @map("line_total") @db.Decimal(18, 2)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice         Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([organizationId, invoiceId])
  @@map("invoice_line_items")
}

/// 收款记录（撤销即删除，并写审计）/ Payment record (reverting deletes it, with an audit entry)
model InvoicePayment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  amount         Decimal       @db.Decimal(18, 2)
  paidOn         DateTime      @map("paid_on") @db.Date
  method         PaymentMethod
  reference      String?       @db.VarChar(100)
  recordedById   String?       @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice       @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  recordedBy     User?         @relation("PaymentRecorder", fields: [organizationId, recordedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, invoiceId, paidOn])
  @@map("invoice_payments")
}

/// 汇率：1 单位外币 = rate 本币（本币为人民币），按生效日期保存历史；查询某日汇率取该日及之前最近生效的一条。
/// Exchange rate: 1 unit of the currency = rate base units (the base is CNY), kept as dated history; the rate for a
/// day is the latest entry effective on or before it.
model ExchangeRate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  currency       String       @db.Char(3)
  rate           Decimal      @db.Decimal(18, 8)
  effectiveDate  DateTime     @map("effective_date") @db.Date
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("RateCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, currency, effectiveDate])
  @@index([organizationId, currency, effectiveDate(sort: Desc)])
  @@map("exchange_rates")
}

/// 市场活动类型 / campaign type
enum CampaignType {
  EXHIBITION
  ADVERTISEMENT
  EMAIL
  WEBINAR
  SOCIAL_MEDIA
  OTHER

  @@map("campaign_type")
}

/// 市场活动状态 / campaign status
enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("campaign_status")
}

/// 市场活动：线索与商机可关联来源活动，用于统计线索、转化、成交与投入产出；有关联记录时不能删除（可改为已取消）。
/// Marketing campaign: leads and deals may name their source campaign for lead, conversion, revenue and ROI
/// statistics; campaigns with linked records cannot be deleted (cancel them instead).
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(100)
  type           CampaignType
  status         CampaignStatus @default(PLANNED)
  startDate      DateTime?      @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  /// 预算与实际花费的币种 / currency of the budget and actual cost
  currency       String         @default("CNY") @db.Char(3)
  budget         Decimal?       @db.Decimal(18, 2)
  actualCost     Decimal?       @map("actual_cost") @db.Decimal(18, 2)
  description    String?        @db.Text
  ownerId        String?        @map("owner_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("CampaignOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  leads          Lead[]
  deals          Deal[]
  webForms       WebForm[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("campaigns")
}

/// 商机联系人角色（对标 Zoho Contact Roles）/ deal contact role (cf. Zoho contact roles)
enum DealContactRoleType {
  DECISION_MAKER
  EVALUATOR
  INFLUENCER
  TECHNICAL_BUYER
  PURCHASING
  END_USER
  OTHER

  @@map("deal_contact_role_type")
}

/// 竞争对手威胁程度 / competitor threat level
enum CompetitorThreat {
  LOW
  MEDIUM
  HIGH

  @@map("competitor_threat")
}

/// 商机联系人角色：联系人必须属于商机的客户；同一商机中一个联系人只出现一次。
/// 删除联系人或商机时一并删除（商机删除前已快照到回收站）。
/// Deal contact role: the contact belongs to the deal's account and appears once per deal; removed with the
/// contact or the deal (deals are snapshotted into the recycle bin first).
model DealContactRole {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  dealId         String              @map("deal_id") @db.Uuid
  contactId      String              @map("contact_id") @db.Uuid
  role           DealContactRoleType
  /// 主要联系人（每个商机最多一个）/ primary contact (at most one per deal)
  isPrimary      Boolean             @default(false) @map("is_primary")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal                @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  contact        Contact             @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, dealId, contactId])
  @@index([organizationId, contactId])
  @@map("deal_contact_roles")
}

/// 商机竞争对手：名称在同一商机内唯一（不区分大小写）；优势、劣势为长文本，审计只记“已修改”。
/// Deal competitor: name unique per deal (case-insensitive); strengths and weaknesses are long text (audited as changed only).
model DealCompetitor {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  dealId         String           @map("deal_id") @db.Uuid
  name           String           @db.VarChar(100)
  threatLevel    CompetitorThreat @default(MEDIUM) @map("threat_level")
  strengths      String?          @db.Text
  weaknesses     String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal             @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, dealId])
  @@map("deal_competitors")
}

/// 个人工作台布局：按顺序保存要显示的卡片键（未列出的即隐藏）；没有记录时使用默认布局。
/// Personal dashboard layout: the keys of the visible cards in order (unlisted cards are hidden); no row means the default layout.
model UserDashboardLayout {
  userId         String       @id @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  widgets        Json
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("user_dashboard_layouts")
}

/// 工单状态 / ticket status
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

/// 工单优先级 / ticket priority
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

/// 工单类型 / ticket type
enum TicketType {
  QUESTION
  PROBLEM
  FEATURE_REQUEST

  @@map("ticket_type")
}

/// 工单来源渠道 / ticket channel
enum TicketChannel {
  PHONE
  EMAIL
  WEB
  ONSITE
  OTHER

  @@map("ticket_channel")
}

/// 服务工单（对标 Zoho Cases）：属于一个客户，可指定该客户的联系人；工单号 CS-年份-序号在组织内唯一。
/// 已解决、已关闭必须有解决方案与解决时间；有工单的客户不能删除（RESTRICT）；删除联系人时清空工单的联系人。
/// Service ticket (cf. Zoho Cases): belongs to an account, optionally one of its contacts; CS-year-sequence numbers
/// are unique per organization. Resolved/closed tickets carry a resolution and resolved time; accounts with tickets
/// cannot be deleted (RESTRICT); deleting a contact clears it on tickets.
model Ticket {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ticketNumber   String         @map("ticket_number") @db.VarChar(20)
  subject        String         @db.VarChar(200)
  description    String?        @db.Text
  accountId      String         @map("account_id") @db.Uuid
  contactId      String?        @map("contact_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  type           TicketType     @default(QUESTION)
  channel        TicketChannel  @default(PHONE)
  /// 处理期限 / due time
  dueAt          DateTime?      @map("due_at") @db.Timestamptz(6)
  /// 处理期限由 SLA 自动计算（改优先级时重算；手动填写后为 false）/ due time computed by the SLA (recomputed on priority change; false once set by hand)
  dueAuto        Boolean        @default(false) @map("due_auto")
  /// 超时升级时间（未升级为空）/ when the ticket was escalated for passing its due time
  escalatedAt    DateTime?      @map("escalated_at") @db.Timestamptz(6)
  resolution     String?        @db.Text
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account        @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  contact        Contact?       @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  owner          User?          @relation("TicketOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  notifications  Notification[]

  articles TicketArticle[]
  comments TicketComment[]

  @@unique([organizationId, id])
  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, accountId])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("tickets")
}

/// 工单号计数器（每个组织每年一行，原子递增；删除的工单号不会被复用）。
/// Ticket number counter (one row per organization and year, incremented atomically; numbers of deleted tickets are never reused).
model TicketCounter {
  organizationId String       @map("organization_id") @db.Uuid
  year           Int
  last           Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
  @@map("ticket_counters")
}

/// 工单评论（处理往来）：对外回复（已告知客户）或内部备注；作者可修改、删除自己的，管理员与经理可删除任何评论。
/// 随工单删除；作者账号保留引用（用户不会被物理删除）。
/// Ticket comment: an external reply (already told to the customer) or an internal note; authors edit or delete
/// their own, admins and managers delete any. Removed with the ticket.
model TicketComment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  ticketId       String       @map("ticket_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  body           String       @db.Text
  isInternal     Boolean      @default(false) @map("is_internal")
  editedAt       DateTime?    @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Cascade)
  author         User         @relation("TicketCommentAuthor", fields: [organizationId, authorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, ticketId, createdAt])
  @@map("ticket_comments")
}

/// 工单 SLA 规则（每个组织一行）：按优先级的处理时限（小时）与升级接收人；没有记录即未启用。
/// Ticket SLA policy (one row per organization): resolution hours per priority and the escalation recipient; no row means disabled.
model TicketSlaPolicy {
  organizationId String       @id @map("organization_id") @db.Uuid
  enabled        Boolean      @default(true)
  urgentHours    Int          @map("urgent_hours")
  highHours      Int          @map("high_hours")
  mediumHours    Int          @map("medium_hours")
  lowHours       Int          @map("low_hours")
  /// 升级接收人（可空）/ escalation recipient (optional)
  escalateToId   String?      @map("escalate_to_id") @db.Uuid
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  escalateTo     User?        @relation("SlaEscalateTo", fields: [organizationId, escalateToId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ticket_sla_policies")
}

/// 知识库文章状态 / knowledge-base article status
enum KbArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("kb_article_status")
}

/// 知识库文章（对标 Zoho Solutions）：纯文本正文；草稿只有作者与知识库管理员可见；已发布、已归档所有人可读。
/// Knowledge-base article (cf. Zoho Solutions): plain-text body; drafts are visible to the author and KB managers only;
/// published and archived articles are readable by everyone.
model KbArticle {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  title          String          @db.VarChar(200)
  body           String          @db.Text
  category       String?         @db.VarChar(50)
  status         KbArticleStatus @default(DRAFT)
  authorId       String          @map("author_id") @db.Uuid
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(6)
  viewCount      Int             @default(0) @map("view_count")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User            @relation("KbArticleAuthor", fields: [organizationId, authorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  tickets        TicketArticle[]

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@index([organizationId, category])
  @@map("kb_articles")
}

/// 工单关联的知识库文章（参考或解决依据）；随工单或文章删除。
/// Knowledge-base article linked to a ticket (reference or basis of the resolution); removed with either side.
model TicketArticle {
  organizationId String       @map("organization_id") @db.Uuid
  ticketId       String       @map("ticket_id") @db.Uuid
  articleId      String       @map("article_id") @db.Uuid
  linkedById     String       @map("linked_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Cascade)
  article        KbArticle    @relation(fields: [organizationId, articleId], references: [organizationId, id], onDelete: Cascade)
  linkedBy       User         @relation("TicketArticleLinker", fields: [organizationId, linkedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([ticketId, articleId])
  @@index([organizationId, articleId])
  @@map("ticket_articles")
}

/// 单据编号计数器（按组织、单据类型、年份，原子递增，删除的编号不复用）。
/// Document number counter per organization, kind and year (atomic; numbers of deleted documents are never reused).
model DocumentCounter {
  organizationId String       @map("organization_id") @db.Uuid
  kind           String       @db.VarChar(20)
  year           Int
  last           Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, kind, year])
  @@map("document_counters")
}

/// 供应商（对标 Zoho Vendors）：组织内名称唯一（不区分大小写）；有采购单的供应商不能删除，可停用。
/// Vendor (cf. Zoho Vendors): names unique per organization (case-insensitive); vendors with purchase orders cannot be
/// deleted, only deactivated.
model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(200)
  contactName    String?         @map("contact_name") @db.VarChar(100)
  phone          String?         @db.VarChar(50)
  email          String?         @db.VarChar(254)
  website        String?         @db.VarChar(200)
  address        String?         @db.VarChar(500)
  /// 默认币种 / default currency
  currency       String          @default("CNY") @db.Char(3)
  /// 付款条件，如“月结 30 天” / payment terms
  paymentTerms   String?         @map("payment_terms") @db.VarChar(100)
  notes          String?         @db.Text
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("vendors")
}

/// 采购单状态 / purchase order status
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

/// 采购单（对标 Zoho Purchase Orders）：草稿可改明细；下单时锁定明细并保存汇率快照；按行收货，全部到货后为已到货。
/// 可关联一张销售订单（以销定采）；编号 PO-年份-序号。
/// Purchase order (cf. Zoho Purchase Orders): lines are editable while a draft; ordering locks them and snapshots the
/// exchange rate; goods are received per line and the order is received once every line is complete. May reference a
/// sales order (purchase to order); numbered PO-year-sequence.
model PurchaseOrder {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  poNumber        String                  @map("po_number") @db.VarChar(30)
  vendorId        String                  @map("vendor_id") @db.Uuid
  salesOrderId    String?                 @map("sales_order_id") @db.Uuid
  subject         String                  @db.VarChar(200)
  status          PurchaseOrderStatus     @default(DRAFT)
  currency        String                  @db.Char(3)
  taxPercent      Decimal                 @default(0) @map("tax_percent") @db.Decimal(5, 2)
  subtotal        Decimal                 @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal                 @default(0) @map("tax_amount") @db.Decimal(18, 2)
  total           Decimal                 @default(0) @db.Decimal(18, 2)
  /// 下单日汇率快照（1 单位外币折合人民币；缺汇率为空）/ order-day rate snapshot (CNY per unit; null when missing)
  exchangeRate    Decimal?                @map("exchange_rate") @db.Decimal(18, 8)
  baseTotal       Decimal?                @map("base_total") @db.Decimal(18, 2)
  expectedDate    DateTime?               @map("expected_date") @db.Date
  deliveryAddress String?                 @map("delivery_address") @db.VarChar(500)
  notes           String?                 @db.Text
  cancelReason    String?                 @map("cancel_reason") @db.VarChar(500)
  createdById     String?                 @map("created_by_id") @db.Uuid
  orderedAt       DateTime?               @map("ordered_at") @db.Timestamptz(6)
  receivedAt      DateTime?               @map("received_at") @db.Timestamptz(6)
  cancelledAt     DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor                  @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict)
  salesOrder      SalesOrder?             @relation(fields: [organizationId, salesOrderId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?                   @relation("PurchaseOrderCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines           PurchaseOrderLineItem[]

  stockMovements StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, poNumber])
  @@index([organizationId, vendorId])
  @@index([organizationId, status])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

/// 采购单明细（产品信息为快照）；已收数量不超过采购数量。
/// Purchase order line (product details are a snapshot); received quantity never exceeds the ordered quantity.
model PurchaseOrderLineItem {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  position         Int
  productSku       String        @map("product_sku") @db.VarChar(50)
  productName      String        @map("product_name") @db.VarChar(200)
  unit             String        @db.VarChar(20)
  quantity         Decimal       @db.Decimal(18, 2)
  receivedQuantity Decimal       @default(0) @map("received_quantity") @db.Decimal(18, 2)
  unitCost         Decimal       @map("unit_cost") @db.Decimal(18, 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(18, 2)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)

  @@unique([purchaseOrderId, position])
  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_line_items")
}

/// 价格表定价方式：固定价（直接使用价格表价）/ 阶梯价（按数量区间叠加折扣）
/// Price book pricing model: FLAT (the list price as is) / DIFFERENTIAL (quantity-tier discounts)
enum PriceBookPricingModel {
  FLAT
  DIFFERENTIAL

  @@map("price_book_pricing_model")
}

/// 价格表（对标 Zoho Price Books）：组织内名称唯一（不区分大小写）；可指定给客户作为默认价格表。
/// Price book (cf. Zoho Price Books): names unique per organization (case-insensitive); can be assigned to accounts as
/// their default.
model PriceBook {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String                @db.VarChar(200)
  currency       String                @default("CNY") @db.Char(3)
  pricingModel   PriceBookPricingModel @default(FLAT) @map("pricing_model")
  description    String?               @db.Text
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        PriceBookEntry[]
  tiers          PriceBookTier[]
  accounts       Account[]

  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("price_books")
}

/// 价格表中的产品价格（每个产品一条）。
/// A product's list price in a price book (one per product).
model PriceBookEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  priceBookId    String       @map("price_book_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  listPrice      Decimal      @map("list_price") @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBook      PriceBook    @relation(fields: [organizationId, priceBookId], references: [organizationId, id], onDelete: Cascade)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([priceBookId, productId])
  @@index([organizationId, productId])
  @@map("price_book_entries")
}

/// 阶梯价数量区间：数量在 [起始, 截止] 内时折扣生效（截止为空表示不封顶）。
/// Differential pricing tier: the discount applies for quantities within [from, to] (no upper bound when to is null).
model PriceBookTier {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  priceBookId     String       @map("price_book_id") @db.Uuid
  fromQuantity    Decimal      @map("from_quantity") @db.Decimal(18, 2)
  toQuantity      Decimal?     @map("to_quantity") @db.Decimal(18, 2)
  discountPercent Decimal      @map("discount_percent") @db.Decimal(5, 2)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBook       PriceBook    @relation(fields: [organizationId, priceBookId], references: [organizationId, id], onDelete: Cascade)

  @@unique([priceBookId, fromQuantity])
  @@map("price_book_tiers")
}

/// 网页表单（对标 Zoho Webforms）：公开页面收集访客信息并自动生成线索。publicKey 是表单地址中的随机标识，可重新生成。
/// Web form (cf. Zoho Webforms): a public page that collects visitor details and creates leads. publicKey is the random
/// identifier in the form URL and can be regenerated.
model WebForm {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String       @db.VarChar(200)
  publicKey       String       @unique @map("public_key") @db.VarChar(64)
  isActive        Boolean      @default(true) @map("is_active")
  /// 表单页标题与说明 / heading and intro on the public page
  title           String       @db.VarChar(200)
  intro           String?      @db.VarChar(1000)
  /// 启用的可选字段与其中必填的字段（姓名始终显示且必填）/ enabled optional fields and the required subset (name is always shown and required)
  fields          String[]     @db.VarChar(30)
  requiredFields  String[]     @map("required_fields") @db.VarChar(30)
  /// 生成线索的来源、负责人、市场活动 / source, owner and campaign of created leads
  source          String       @default("WEBSITE") @db.VarChar(50)
  ownerId         String?      @map("owner_id") @db.Uuid
  /// 按分配规则分配负责人（与固定负责人互斥）/ assign the owner by assignment rules (exclusive with a fixed owner)
  assignByRule    Boolean      @default(false) @map("assign_by_rule")
  campaignId      String?      @map("campaign_id") @db.Uuid
  successMessage  String?      @map("success_message") @db.VarChar(500)
  submissionCount Int          @default(0) @map("submission_count")
  lastSubmittedAt DateTime?    @map("last_submitted_at") @db.Timestamptz(6)
  createdById     String?      @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?        @relation("WebFormOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?        @relation("WebFormCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  campaign        Campaign?    @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  leads           Lead[]

  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("web_forms")
}

/// 评分对象：线索、客户、联系人 / scored entity: lead, account, contact
enum ScoringEntity {
  LEAD
  ACCOUNT
  CONTACT
  DEAL

  @@map("scoring_entity")
}

/// 评分规则类型：字段等于某值、字段已填写、已完成跟进数、关联记录数（后两者每条加分，有上限）
/// Scoring rule kind: field equals a value, field filled, completed activities, related records (the last two per item, capped)
enum ScoringRuleKind {
  FIELD_EQUALS
  FIELD_FILLED
  ACTIVITY_COUNT
  RELATED_COUNT
  /// 金额（折合人民币）达到阈值，仅商机 / amount (in CNY) at least a threshold, deals only
  AMOUNT_AT_LEAST

  @@map("scoring_rule_kind")
}

/// 评分规则（对标 Zoho Scoring Rules）：按对象（线索、客户、联系人）配置，启用的规则命中即加（或减）分；分数由数据库
/// 函数 lead_score_items、account_score_items、contact_score_items 计算。可用字段见迁移中的约束。
/// Scoring rule (cf. Zoho Scoring Rules), per entity (lead, account, contact): active rules add (or subtract) points when
/// matched; scores are computed by the database functions lead_score_items, account_score_items and contact_score_items.
/// Allowed fields are listed in the migration's check constraint.
model ScoringRule {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  entity         ScoringEntity   @default(LEAD)
  kind           ScoringRuleKind
  field          String?         @db.VarChar(30)
  value          String?         @db.VarChar(50)
  points         Int
  /// 计数类规则最多计入的条数 / max items counted by a count rule
  maxCount       Int?            @map("max_count")
  position       Int
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, entity, position])
  @@map("scoring_rules")
}

/// 评分分级阈值（每个组织每种对象一行）：分数 ≥ 热门阈值为热门，≥ 温和阈值为温和，其余为冷淡。
/// Score grade thresholds (one row per organization and entity): hot at or above hotScore, warm at or above warmScore.
model ScoringSettings {
  organizationId String        @map("organization_id") @db.Uuid
  entity         ScoringEntity @default(LEAD)
  hotScore       Int           @default(60) @map("hot_score")
  warmScore      Int           @default(30) @map("warm_score")
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, entity])
  @@map("scoring_settings")
}

/// 分配规则适用的对象 / entities an assignment rule applies to
enum AssignmentEntity {
  LEAD

  @@map("assignment_entity")
}

/// 分配规则（对标 Zoho Assignment Rules）：按顺序匹配条件（全部满足），命中后在负责人列表中轮流分配。
/// conditions 为 [{field, op, value}]（服务端校验，最多 5 条，空数组表示匹配全部）；cursor 为已分配次数（轮转指针）。
/// Assignment rule (cf. Zoho Assignment Rules): rules are tried in order; all conditions must hold; a match assigns
/// round-robin among the rule's users. conditions is [{field, op, value}] (validated server-side, at most 5; empty
/// matches everything); cursor counts assignments made (the round-robin pointer).
model AssignmentRule {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  entity         AssignmentEntity     @default(LEAD)
  name           String               @db.VarChar(100)
  conditions     Json                 @default("[]")
  position       Int
  cursor         Int                  @default(0)
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          AssignmentRuleUser[]

  @@unique([organizationId, id])
  @@index([organizationId, entity, position])
  @@map("assignment_rules")
}

/// 分配规则的负责人（按 position 轮流；复合外键保证与规则、用户同组织）。
/// Users of an assignment rule, taken in position order; composite FKs keep rule and user in the same organization.
model AssignmentRuleUser {
  organizationId String         @map("organization_id") @db.Uuid
  ruleId         String         @map("rule_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  position       Int
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           AssignmentRule @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Cascade)
  user           User           @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([ruleId, userId])
  @@index([organizationId, userId])
  @@map("assignment_rule_users")
}

/// 商机阶段历史（对标 Zoho Stage History）：新建商机及阶段、金额、币种、预计成交日变化时由数据库触发器写入，
/// 修改人取事务内设置的 yonlink.actor_id（系统写入时为空）；只增不改，随商机删除。
/// Deal stage history (cf. Zoho Stage History): written by a database trigger when a deal is created or its stage,
/// amount, currency or expected close date changes; changed_by comes from the transaction's yonlink.actor_id (null for
/// system writes). Append-only; removed with the deal.
model DealStageHistory {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  dealId            String       @map("deal_id") @db.Uuid
  stage             DealStage
  amount            Decimal      @db.Decimal(18, 2)
  currency          String       @db.Char(3)
  expectedCloseDate DateTime?    @map("expected_close_date") @db.Date
  changedById       String?      @map("changed_by_id") @db.Uuid
  changedAt         DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal              Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  changedBy         User?        @relation("StageChanger", fields: [organizationId, changedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, dealId, changedAt])
  @@map("deal_stage_history")
}

/// 工作流适用的对象 / entities a workflow rule applies to
enum WorkflowEntity {
  LEAD
  DEAL

  @@map("workflow_entity")
}

/// 工作流触发时机 / when a workflow rule fires
enum WorkflowTrigger {
  /// 新建时 / on create
  CREATE
  /// 编辑时（有字段变化）/ on edit (some field changed)
  UPDATE
  /// 新建或编辑时 / on create or edit
  CREATE_OR_UPDATE
  /// 指定字段变化时 / when a given field changes
  FIELD_CHANGE

  @@map("workflow_trigger")
}

/// 工作流规则（对标 Zoho Workflow Rules）：记录新建/编辑时按触发时机与条件执行动作（更新字段、指派、创建任务、通知、加标签）。
/// conditions、actions 为 JSON（服务端按对象校验）；工作流执行的改动不会再触发工作流。
/// Workflow rule (cf. Zoho Workflow Rules): on record create/edit, matching the trigger and conditions, run actions
/// (field update, assign, create task, notify, add tag). conditions and actions are JSON validated server-side per
/// entity; changes made by workflows never trigger workflows.
model WorkflowRule {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(100)
  entity         WorkflowEntity
  trigger        WorkflowTrigger
  /// 字段变化触发时的字段 / the field for FIELD_CHANGE
  triggerField   String?         @map("trigger_field") @db.VarChar(30)
  conditions     Json            @default("[]")
  actions        Json
  isActive       Boolean         @default(true) @map("is_active")
  /// 执行次数与最近执行时间 / run count and last run time
  runCount       Int             @default(0) @map("run_count")
  lastRunAt      DateTime?       @map("last_run_at") @db.Timestamptz(6)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("WorkflowCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, entity, isActive])
  @@map("workflow_rules")
}

/// 审批状态 / approval status
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

/// 审批记录动作 / approval history action
enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  RECALL

  @@map("approval_action")
}

/// 报价单审批规则（每组织一行，对标 Zoho Approval Processes）：启用后，任一明细折扣超过上限或总计折合人民币达到金额时，
/// 发送前须经有 quote.approve 权限的他人审批。
/// Quote approval policy (one row per organization; cf. Zoho Approval Processes): when enabled, a quote whose line
/// discount exceeds the cap or whose total in CNY reaches the amount must be approved by someone else with quote.approve
/// before it can be sent.
model QuoteApprovalSettings {
  organizationId     String       @id @map("organization_id") @db.Uuid
  enabled            Boolean      @default(false)
  /// 折扣上限（%），超过即需审批；为空表示不按折扣 / discount cap (%); above it needs approval; null disables the check
  maxDiscountPercent Decimal?     @map("max_discount_percent") @db.Decimal(5, 2)
  /// 总计折合人民币达到该金额需审批；为空表示不按金额 / CNY total at or above this needs approval; null disables the check
  minTotal           Decimal?     @map("min_total") @db.Decimal(18, 2)
  updatedById        String?      @map("updated_by_id") @db.Uuid
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy          User?        @relation("ApprovalSettingsUpdater", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("quote_approval_settings")
}

/// 报价单审批历史（只增不改）/ quote approval history (append-only)
model QuoteApproval {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  quoteId        String         @map("quote_id") @db.Uuid
  action         ApprovalAction
  actorId        String         @map("actor_id") @db.Uuid
  comment        String?        @db.VarChar(500)
  reasons        Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote          @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)
  actor          User           @relation("ApprovalActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, quoteId, createdAt])
  @@map("quote_approvals")
}

/// 库存变动原因 / stock movement reasons
enum StockReason {
  /// 手工调整（含盘点）/ manual adjustment (stock counts included)
  ADJUSTMENT
  /// 采购收货 / purchase receipt
  PURCHASE_RECEIPT
  /// 销售发货 / sales shipment
  SALES_SHIPMENT
  /// 已发货订单取消退回 / return of a cancelled shipped order
  SALES_RETURN

  @@map("stock_reason")
}

/// 库存流水（对标 Zoho Inventory 的库存变动）：数量带符号；写入时由数据库触发器原子更新产品库存并记录变动后余额；只增不改。
/// Stock movement (cf. Zoho Inventory): signed quantity; on insert a database trigger atomically updates the product's
/// stock and records the balance after; append-only.
model StockMovement {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  productId       String         @map("product_id") @db.Uuid
  reason          StockReason
  quantity        Decimal        @db.Decimal(18, 2)
  /// 变动后余额（触发器写入）/ balance after the movement (set by the trigger)
  balanceAfter    Decimal        @default(0) @map("balance_after") @db.Decimal(18, 2)
  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  salesOrderId    String?        @map("sales_order_id") @db.Uuid
  note            String?        @db.VarChar(200)
  actorId         String?        @map("actor_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 有库存流水的产品不能删除 / products with stock history cannot be deleted
  product         Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// 来源单据删除时置空（流水保留）；同组织由触发器保证 / cleared when the source order is deleted (the movement stays); same-org enforced by a trigger
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  actor           User?          @relation("StockActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, productId, createdAt])
  @@index([organizationId, salesOrderId])
  @@map("stock_movements")
}
