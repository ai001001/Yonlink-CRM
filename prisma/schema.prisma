// 永联CRM MVP 数据模型 / Yonlink-CRM MVP data model
// 约定 / Conventions:
//  - 所有业务表带 organization_id，由服务端会话决定 / every business table carries organization_id set by the server session
//  - UUID 主键、timestamptz(UTC)、金额 Decimal(18,2) / UUID PKs, UTC timestamptz, Decimal(18,2) money

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            @db.VarChar(200)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  users         User[]
  accounts      Account[]
  contacts      Contact[]
  leads         Lead[]
  deals         Deal[]
  activities    Activity[]
  auditLogs     AuditLog[]
  notes         Note[]
  products      Product[]
  dealItems     DealLineItem[]
  quotes        Quote[]
  quoteItems    QuoteLineItem[]
  tags          Tag[]
  leadTags      LeadTag[]
  accountTags   AccountTag[]
  dealTags      DealTag[]
  recycleBin    RecycleBinItem[]
  savedViews    SavedView[]
  viewDefaults  UserViewDefault[]
  attachments   Attachment[]
  salesTargets  SalesTarget[]
  notifications Notification[]

  @@map("organizations")
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  email             String            @db.VarChar(254)
  name              String            @db.VarChar(100)
  passwordHash      String            @map("password_hash")
  notifications     Notification[]    @relation("NotificationRecipient")
  notificationsSent Notification[]    @relation("NotificationActor")
  /// 角色（服务端每个请求从数据库读取）/ role (read from the DB on every request)
  role              UserRole          @default(SALES)
  isActive          Boolean           @default(true) @map("is_active")
  /// 演示账号：仅在 DEMO_LOGIN_ENABLED=1 时可免密一键登录 / demo account: password-less login only when DEMO_LOGIN_ENABLED=1
  isDemo            Boolean           @default(false) @map("is_demo")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions          Session[]
  ownedLeads        Lead[]            @relation("LeadOwner")
  ownedAccounts     Account[]         @relation("AccountOwner")
  ownedDeals        Deal[]            @relation("DealOwner")
  ownedActivities   Activity[]        @relation("ActivityOwner")
  auditLogs         AuditLog[]        @relation("AuditActor")
  notes             Note[]            @relation("NoteAuthor")
  createdQuotes     Quote[]           @relation("QuoteCreator")
  deletedItems      RecycleBinItem[]  @relation("RecycleDeleter")
  savedViews        SavedView[]
  viewDefaults      UserViewDefault[]
  uploads           Attachment[]      @relation("AttachmentUploader")
  salesTargets      SalesTarget[]     @relation("TargetOwner")
  targetsUpdated    SalesTarget[]     @relation("TargetUpdater")

  // 支持 (organization_id, id) 复合外键，防止跨组织引用负责人
  // composite key so owner FKs cannot point at another organization's user
  @@unique([organizationId, id])
  @@unique([email])
  @@map("users")
}

/// 系统角色 / System roles
enum UserRole {
  ADMIN
  MANAGER
  SALES
  READONLY

  @@map("user_role")
}

/// 服务端会话：只保存令牌的 SHA-256 哈希 / server session: only the SHA-256 hash of the token is stored
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED

  @@map("lead_status")
}

model Lead {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  ownerId            String?        @map("owner_id") @db.Uuid
  name               String         @db.VarChar(100)
  company            String?        @db.VarChar(200)
  title              String?        @db.VarChar(100)
  phone              String?        @db.VarChar(50)
  mobile             String?        @db.VarChar(50)
  email              String?        @db.VarChar(254)
  source             String?        @db.VarChar(50)
  status             LeadStatus     @default(NEW)
  description        String?        @db.Text
  notifications      Notification[]
  // 线索转化结果（只由服务端转化流程写入）/ conversion result (written only by the server-side conversion)
  // 关联记录删除时置空；同组织约束由数据库触发器保证 / set null on delete; same-org enforced by a DB trigger
  convertedAccountId String?        @map("converted_account_id") @db.Uuid
  convertedContactId String?        @map("converted_contact_id") @db.Uuid
  convertedDealId    String?        @map("converted_deal_id") @db.Uuid
  convertedAt        DateTime?      @map("converted_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?          @relation("LeadOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  convertedAccount   Account?       @relation("LeadConvertedAccount", fields: [convertedAccountId], references: [id], onDelete: SetNull)
  convertedContact   Contact?       @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedDeal      Deal?          @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities         Activity[]
  notes              Note[]
  tags               LeadTag[]
  attachments        Attachment[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([convertedAccountId])
  @@index([convertedContactId])
  @@index([convertedDealId])
  @@map("leads")
}

model Account {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  name           String         @db.VarChar(200)
  industry       String?        @db.VarChar(50)
  phone          String?        @db.VarChar(50)
  website        String?        @db.VarChar(254)
  address        String?        @db.VarChar(500)
  description    String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("AccountOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  notes          Note[]
  convertedLeads Lead[]         @relation("LeadConvertedAccount")
  tags           AccountTag[]
  attachments    Attachment[]
  notifications  Notification[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("accounts")
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  name           String       @db.VarChar(100)
  title          String?      @db.VarChar(100)
  phone          String?      @db.VarChar(50)
  email          String?      @db.VarChar(254)
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 删除客户时级联删除其联系人 / contacts are deleted with their account
  account        Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  convertedLeads Lead[]       @relation("LeadConvertedContact")

  @@index([organizationId, accountId])
  @@map("contacts")
}

enum DealStage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST

  @@map("deal_stage")
}

model Deal {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  ownerId           String?        @map("owner_id") @db.Uuid
  accountId         String         @map("account_id") @db.Uuid
  name              String         @db.VarChar(200)
  amount            Decimal        @default(0) @db.Decimal(18, 2)
  currency          String         @default("CNY") @db.Char(3)
  stage             DealStage      @default(QUALIFICATION)
  expectedCloseDate DateTime?      @map("expected_close_date") @db.Date
  description       String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?          @relation("DealOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  notifications     Notification[]
  // 有商机的客户不能删除 / accounts with deals cannot be deleted
  account           Account        @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  activities        Activity[]
  notes             Note[]
  lineItems         DealLineItem[]
  quotes            Quote[]
  convertedLeads    Lead[]         @relation("LeadConvertedDeal")
  tags              DealTag[]
  attachments       Attachment[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, accountId])
  @@index([organizationId, stage])
  @@map("deals")
}

enum ActivityType {
  CALL
  MEETING
  VISIT
  TASK

  @@map("activity_type")
}

model Activity {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  type           ActivityType
  subject        String         @db.VarChar(200)
  content        String?        @db.Text
  dueAt          DateTime?      @map("due_at") @db.Timestamptz(6)
  completed      Boolean        @default(false)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  accountId      String?        @map("account_id") @db.Uuid
  leadId         String?        @map("lead_id") @db.Uuid
  dealId         String?        @map("deal_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("ActivityOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  notifications  Notification[]
  // 关联记录删除时跟进记录一并删除 / activities are removed with the related record
  account        Account?       @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  lead           Lead?          @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?          @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, completed, dueAt])
  @@index([organizationId, accountId])
  @@index([organizationId, leadId])
  @@index([organizationId, dealId])
  @@map("activities")
}

/// 审计日志（只能追加：数据库触发器禁止 UPDATE/DELETE；内容已脱敏）
/// Audit log (append-only: a DB trigger forbids UPDATE/DELETE; contents are redacted)
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// 操作人；登录失败等场景为被尝试的账号 / actor; for failed logins the targeted account
  actorId        String?      @map("actor_id") @db.Uuid
  /// 例如 lead.create / auth.login_failed / e.g. lead.create, auth.login_failed
  action         String       @db.VarChar(50)
  entityType     String       @map("entity_type") @db.VarChar(30)
  /// 被操作记录 ID（不设外键，记录删除后日志仍保留）/ target id (no FK so logs outlive the record)
  entityId       String?      @map("entity_id") @db.Uuid
  /// 脱敏后的变更内容 / redacted change set
  changes        Json?        @db.JsonB
  ip             String?      @db.VarChar(64)
  userAgent      String?      @map("user_agent") @db.VarChar(300)
  /// 使用 clock_timestamp()：同一事务内多条记录也能按真实写入顺序排序
  /// clock_timestamp() keeps entries written in one transaction in real order
  createdAt      DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// 备注：只属于一条线索、客户或商机（CHECK 保证恰好一个）；随所属记录级联删除。
/// Note attached to exactly one lead, account or deal (enforced by CHECK); deleted with its record.
model Note {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  content        String       @db.Text
  /// 内容最后一次被修改的时间（未修改为空）/ when the content was last changed (null if never)
  editedAt       DateTime?    @map("edited_at") @db.Timestamptz(6)
  leadId         String?      @map("lead_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User         @relation("NoteAuthor", fields: [organizationId, authorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lead           Lead?        @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  account        Account?     @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt(sort: Desc)])
  @@index([organizationId, accountId, createdAt(sort: Desc)])
  @@index([organizationId, dealId, createdAt(sort: Desc)])
  @@map("notes")
}

/// 产品目录（组织内 SKU 唯一；被商机使用的产品不能删除，只能停用）
/// Product catalog (SKU unique per organization; products in use cannot be deleted, only deactivated)
model Product {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  sku            String         @db.VarChar(50)
  name           String         @db.VarChar(200)
  category       String?        @db.VarChar(50)
  unit           String         @default("件") @db.VarChar(20)
  unitPrice      Decimal        @default(0) @map("unit_price") @db.Decimal(18, 2)
  currency       String         @default("CNY") @db.Char(3)
  description    String?        @db.Text
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems      DealLineItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@map("products")
}

/// 商机产品明细（保存下单时的产品名称与 SKU；小计由服务端按十进制精确计算）
/// Deal line item (keeps the product name and SKU at the time; totals computed server-side in decimal)
model DealLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  dealId          String       @map("deal_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  productName     String       @map("product_name") @db.VarChar(200)
  productSku      String       @map("product_sku") @db.VarChar(50)
  quantity        Decimal      @db.Decimal(18, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal      @map("line_total") @db.Decimal(18, 2)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal            Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  product         Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, dealId, createdAt])
  @@index([organizationId, productId])
  @@map("deal_line_items")
}

/// 报价单状态 / Quote status
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@map("quote_status")
}

/// 报价单（由商机生成，明细为生成时的快照；草稿可修改，发送后内容冻结）
/// Quote generated from a deal; line items are a snapshot; drafts are editable, content is frozen once sent
model Quote {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  dealId         String          @map("deal_id") @db.Uuid
  /// 组织内唯一的报价单号，如 QT-2026-0001 / per-organization unique number
  quoteNumber    String          @map("quote_number") @db.VarChar(30)
  subject        String          @db.VarChar(200)
  status         QuoteStatus     @default(DRAFT)
  currency       String          @db.Char(3)
  validUntil     DateTime?       @map("valid_until") @db.Date
  taxPercent     Decimal         @default(0) @map("tax_percent") @db.Decimal(5, 2)
  subtotal       Decimal         @db.Decimal(18, 2)
  taxAmount      Decimal         @map("tax_amount") @db.Decimal(18, 2)
  total          Decimal         @db.Decimal(18, 2)
  terms          String?         @db.Text
  notes          String?         @db.Text
  createdById    String?         @map("created_by_id") @db.Uuid
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(6)
  decidedAt      DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  createdBy      User?           @relation("QuoteCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lines          QuoteLineItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, quoteNumber])
  @@index([organizationId, dealId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("quotes")
}

/// 报价单明细（纯快照，不引用产品，产品后续变化或删除不影响已出具的报价单）
/// Quote line item: a pure snapshot without a product reference
model QuoteLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  quoteId         String       @map("quote_id") @db.Uuid
  position        Int
  productSku      String       @map("product_sku") @db.VarChar(50)
  productName     String       @map("product_name") @db.VarChar(200)
  unit            String       @db.VarChar(20)
  quantity        Decimal      @db.Decimal(18, 2)
  unitPrice       Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal      @map("line_total") @db.Decimal(18, 2)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote           Quote        @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, quoteId, position])
  @@map("quote_line_items")
}

/// 标签（组织内名称唯一，不区分大小写：name_key = 小写去空格的名称）
/// Tag; names are unique per organization case-insensitively via name_key (lower-cased, trimmed)
model Tag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(30)
  nameKey        String       @map("name_key") @db.VarChar(30)
  color          String       @default("blue") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          LeadTag[]
  accounts       AccountTag[]
  deals          DealTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@map("tags")
}

/// 线索标签 / Lead tag assignment
model LeadTag {
  organizationId String       @map("organization_id") @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([organizationId, tagId])
  @@map("lead_tags")
}

/// 客户标签 / Account tag assignment
model AccountTag {
  organizationId String       @map("organization_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([accountId, tagId])
  @@index([organizationId, tagId])
  @@map("account_tags")
}

/// 商机标签 / Deal tag assignment
model DealTag {
  organizationId String       @map("organization_id") @db.Uuid
  dealId         String       @map("deal_id") @db.Uuid
  tagId          String       @map("tag_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal           Deal         @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@index([organizationId, tagId])
  @@map("deal_tags")
}

/// 回收站对象类型 / Recycle-bin entity type
enum RecycleEntity {
  lead
  account
  deal

  @@map("recycle_entity")
}

/// 回收站条目：删除时保存记录及随之删除的附属数据快照（payload），原记录已真正删除；30 天内可恢复。
/// reserved_numbers 记录快照中报价单的编号，避免被新报价单复用而导致恢复冲突。
/// Recycle-bin entry: a snapshot of the record and the data deleted with it (the rows themselves are gone);
/// restorable for 30 days. reserved_numbers keeps the snapshot's quote numbers from being reused.
model RecycleBinItem {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  entityType      RecycleEntity @map("entity_type")
  entityId        String        @map("entity_id") @db.Uuid
  displayName     String        @map("display_name") @db.VarChar(200)
  /// 附属数据数量摘要 / counts of the related data
  summary         Json
  payload         Json
  reservedNumbers String[]      @default([]) @map("reserved_numbers")
  deletedById     String?       @map("deleted_by_id") @db.Uuid
  deletedAt       DateTime      @default(now()) @map("deleted_at") @db.Timestamptz(6)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedBy       User?         @relation("RecycleDeleter", fields: [organizationId, deletedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, deletedAt(sort: Desc)])
  @@index([organizationId, expiresAt])
  @@map("recycle_bin_items")
}

/// 视图所属列表 / list a saved view belongs to
enum ViewEntity {
  leads
  accounts
  deals
  activities

  @@map("view_entity")
}

/// 保存的视图：列表筛选条件（服务端按列表白名单校验）；私有或共享给全组织。
/// 视图只保存筛选条件，数据仍按查看者的权限过滤，共享视图不会扩大可见范围。
/// Saved view: list filters (validated against a per-list whitelist), private or shared with the organization;
/// records are still filtered by the viewer's permissions, so sharing never widens visibility.
model SavedView {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  ownerId        String            @map("owner_id") @db.Uuid
  entity         ViewEntity
  name           String            @db.VarChar(50)
  filters        Json
  shared         Boolean           @default(false)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User              @relation(fields: [organizationId, ownerId], references: [organizationId, id], onDelete: Cascade)
  defaults       UserViewDefault[]

  @@unique([organizationId, id])
  @@unique([organizationId, ownerId, entity, name])
  @@index([organizationId, entity, shared])
  @@map("saved_views")
}

/// 用户在某个列表的默认视图 / a user's default view for a list
model UserViewDefault {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  entity         ViewEntity
  viewId         String       @map("view_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  view           SavedView    @relation(fields: [organizationId, viewId], references: [organizationId, id], onDelete: Cascade)

  @@id([userId, entity])
  @@index([organizationId, viewId])
  @@map("user_view_defaults")
}

/// 附件元数据；文件内容存放在附件目录 <组织 ID>/<附件 ID>（不使用原文件名，避免路径注入）。
/// 恰好属于一条线索、客户或商机；随所属记录删除（进入回收站快照，彻底删除时才删除文件）。
/// Attachment metadata; content lives at <organization id>/<attachment id> in the attachment directory (never the
/// original name). Belongs to exactly one lead, account or deal; removed with it (kept in the recycle-bin snapshot,
/// the file is deleted only on purge).
model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  leadId         String?      @map("lead_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  fileName       String       @map("file_name") @db.VarChar(200)
  contentType    String       @map("content_type") @db.VarChar(100)
  size           Int
  sha256         String       @db.Char(64)
  uploadedById   String       @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("AttachmentUploader", fields: [organizationId, uploadedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lead           Lead?        @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  account        Account?     @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, dealId, createdAt])
  @@map("attachments")
}

/// 销售目标：负责人 × 月份 × 币种的目标金额（月份为该月 1 日）。
/// Sales target: amount per owner, month (first day of the month) and currency.
model SalesTarget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  month          DateTime     @db.Date
  currency       String       @db.Char(3)
  amount         Decimal      @db.Decimal(18, 2)
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("TargetOwner", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  updatedBy      User?        @relation("TargetUpdater", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, userId, month, currency])
  @@index([organizationId, month])
  @@map("sales_targets")
}

/// 通知类型 / notification type
enum NotificationType {
  /// 记录被分配给我 / a record was assigned to me
  ASSIGNED
  /// 我的跟进即将到期 / my activity is coming due
  ACTIVITY_DUE

  @@map("notification_type")
}

/// 站内通知：只属于接收人本人；恰好关联一条线索、客户、商机或跟进，随所属记录删除。
/// title 为生成时的记录名称快照；dedup_key 防止同一提醒重复生成（同一接收人内唯一）。
/// In-app notification owned by its recipient; linked to exactly one lead, account, deal or activity and removed
/// with it. title snapshots the record name; dedup_key keeps a reminder from being generated twice per recipient.
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  actorId        String?          @map("actor_id") @db.Uuid
  leadId         String?          @map("lead_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  dealId         String?          @map("deal_id") @db.Uuid
  activityId     String?          @map("activity_id") @db.Uuid
  title          String           @db.VarChar(200)
  dueAt          DateTime?        @map("due_at") @db.Timestamptz(6)
  dedupKey       String?          @map("dedup_key") @db.VarChar(100)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation("NotificationRecipient", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [organizationId, actorId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  lead           Lead?            @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  account        Account?         @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  deal           Deal?            @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade)
  activity       Activity?        @relation(fields: [organizationId, activityId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([organizationId, activityId])
  @@index([organizationId, leadId])
  @@index([organizationId, accountId])
  @@index([organizationId, dealId])
  @@map("notifications")
}
